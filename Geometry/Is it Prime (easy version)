# Is it Prime (easy version)
# Gym - 556990B 

#include <iostream>
using namespace std;

bool isprime (long long x){
    if (x==2)
    return true;
    if (x<2)return false;
    if ((x%2)==0)
    return false;

    for (long long i = 3; i*i <=x ; i+=2)
    {
        if (x%i==0)return false;
    }
    return true;
}

int main(){
long long x;
cin >>x;
cout <<(isprime(x)?"Yes":"No");
    return 0;
}
