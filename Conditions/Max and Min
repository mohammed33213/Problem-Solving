# Max and Min 
# Gym - 287306J 

#include <iostream>
#include <algorithm>
using namespace std;

int main()
{
    long long num1, num2, num3;
    cin >> num1 >> num2 >> num3;

    long long minimum_number = min({num1 , num2, num3});
    long long maximum_number = max({num1 , num2, num3});
    
    cout << minimum_number <<" "<< maximum_number;

return 0;
}
