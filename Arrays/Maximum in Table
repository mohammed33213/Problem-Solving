# Maximum in Table 
# CodeForces - 509A 

#include <iostream>
using namespace std;

int main() {
int n;
cin>>n;
int arr [n+1][n+1];

for (int i = 1; i <=n ; i++)
{
for (int j = 1; j <= n; j++)
{
    arr[i][j]=1;
    arr[j][j]=1;
}}

for (int i = 2; i <=n; i++)
{
for (int j = 2; j <= n; j++)
{
    arr[i][j]=arr[i][j-1]+arr[i-1][j];
}
}

cout <<arr[n][n]<<endl;
    return 0;
}
