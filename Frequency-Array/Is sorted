#include <iostream>
using namespace std;

int main() {
    int n;
    cin >> n;  
    int arr[n]; 
    
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    bool isNonIncreasing = true;
    for (int i = 0; i < n - 1; i++) {
        if (arr[i] < arr[i + 1]) { 
            isNonIncreasing = false;
            break;
        }
    }

    if (isNonIncreasing) {
        cout << "Yes" << endl;
    } else {
        cout << "No" << endl;
    }

    return 0;
}
