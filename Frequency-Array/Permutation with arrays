# Permutation with arrays
# Gym - 219774R 

#include <iostream>
#include <algorithm>
using namespace std;

int main() {
    int n;
    cin >> n  ;  
    int C[n],X[n];

    for (int i = 0; i < n; i++)
    {
        cin >>C[i];
    } 
    for (int i = 0; i < n; i++)
    {
        cin >>X[i];
    }
    sort(X, X + n);
    sort(C, C + n);
    

    if (equal(C, C + n, X)) 
    {
        cout << "yes" << endl;
    }
    else
    {
        cout << "no" << endl;
    }

    return 0;
}
