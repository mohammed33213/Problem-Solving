# FizzBuzz Sum 
# AtCoder - abc162_b 

#include <iostream>
using namespace std;

int main() {
        int x;
        cin >>x;
        long long sum=0;

        for (int i = 1; i <=x; i++)
        {
        if (i%5    !=0 && i%3  !=0)
        
        sum +=i;
        }
        
        cout << sum;
        return 0;
}
