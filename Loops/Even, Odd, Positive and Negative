# Even, Odd, Positive and Negative
# Gym - 219432C 
#include <iostream>
#include <algorithm>

using namespace std;

int main ()
{
    int num;

    int postive = 0;
    int negative = 0;

    int even = 0;
    int odd  = 0;


    cin >>num;                            
        for (int i = 0; i < num ; i++)        
        {
        int x;
        cin >>x;
        
                if (x>0)
        
        postive++;
        

                else if (x<0)
        
        negative++;
        

                if (x%2==0)
        
        even++;
        
                else
        
        odd++;
        }
                cout <<"Even: " <<even<<endl;
                cout <<"Odd: " <<odd<<endl; 
                cout <<"Positive: " <<postive<<endl; 
                cout <<"Negative: " <<negative<<endl; 
                 
                return 0;
}  
